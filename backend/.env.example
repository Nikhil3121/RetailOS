# Copy to `.env` and adjust for your machine. All values are read by app.core.config.Settings.
# Never commit a real .env file.

# ---- Runtime ---------------------------------------------------------------
ENVIRONMENT=development            # development | staging | production
DEBUG=true
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1

# ---- Server ----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ---- Database --------------------------------------------------------------
# Async DSN. Uses asyncpg for Postgres. SQLite fallback: sqlite+aiosqlite:///./retailos.db
DATABASE_URL=sqlite+aiosqlite:///./retailos.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ---- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- Security --------------------------------------------------------------
# Generate a real value with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-real-deployments-please-generate-a-64-byte-urlsafe-token
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

# ---- CORS ------------------------------------------------------------------
# Comma-separated origin list. The Electron renderer served by Vite lives at :5173 in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Rate limiting ---------------------------------------------------------
RATE_LIMIT_DEFAULT=200/minute
